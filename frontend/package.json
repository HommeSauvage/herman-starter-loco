{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "ci": "bun run lint && bun run format:check && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.60.0",
    "radix-ui": "^1.8.1",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^8.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^5",
    "vite": "^8.2.1"
  }
}
